digraph StartupJobSequence {
  graph [
    rankdir=TB,
    bgcolor="transparent",
    pad=0.24,
    nodesep=0.32,
    ranksep=0.46,
    splines=polyline,
    compound=true,
    newrank=true,
    fontname="Noto Sans CJK SC",
    fontsize=17,
    fontcolor="#332017"
  ];
  node [
    shape=rect,
    style="rounded,filled",
    fontname="Noto Sans CJK SC",
    fontsize=10.5,
    color="#76513b",
    fontcolor="#332017",
    fillcolor="#fffaf0",
    penwidth=1.15,
    margin="0.13,0.09"
  ];
  edge [
    fontname="Noto Sans CJK SC",
    fontsize=8.6,
    color="#76513b",
    fontcolor="#76513b",
    penwidth=1.2,
    arrowsize=0.68
  ];

  subgraph cluster_startup {
    label="应用生命周期 · 每个进程一次";
    labelloc=t;
    labeljust=l;
    color="#76513b";
    fillcolor="#f4e8d7";
    style="rounded,filled";
    penwidth=1.35;

    manifest [label="Runtime Manifest\n任务类型 + Robot + Runtime"];
    app [label="MotionApplication\nCREATED → REGISTERING", fillcolor="#4b2f22", fontcolor="#fff8ed"];
    install [label="install packs\nTask / Algorithm / Runtime / Observer"];
    freeze [label="RegistryHub.freeze()\n注册结束，不再接受修改", fillcolor="#ddc7aa"];
    compile [label="WorkflowCompiler\n配置 → 类型化流程图"];
    bind [label="RuntimeGraphBuilder\n角色 + 依赖 → 实例"];
    probe [label="Compatibility + Health\n合同 / 资源 / warmup"];
    ready [label="READY\n开放 Task Ingress", fillcolor="#687157", fontcolor="#fffaf0", penwidth=1.7];
    startup_failed [label="STARTUP_FAILED\n入口保持关闭", fillcolor="#f4dfd7", color="#8a4037", fontcolor="#8a4037"];

    manifest -> app -> install -> freeze;
    manifest -> compile [label="workflow"];
    freeze -> bind [label="factories"];
    compile -> bind [label="compiled graph"];
    bind -> probe -> ready;
    probe -> startup_failed [label="typed startup error", color="#8a4037", fontcolor="#8a4037", style=dashed];
  }

  subgraph cluster_job {
    label="MotionJob 生命周期 · 每个任务一次";
    labelloc=t;
    labeljust=l;
    color="#8b6b58";
    fillcolor="#fff7ea";
    style="rounded,filled";
    penwidth=1.35;

    request [label="MotionTaskRequest\njob_id + task_type + payload"];
    admit [label="JobManager\n准入 / 幂等 / 取消令牌"];
    snapshot [label="SnapshotManager\n固定 State / Scene / Tool", fillcolor="#efe1cf"];
    mailbox [label="Job Mailbox\nResult 唯一可靠入口", fillcolor="#ddc7aa", penwidth=1.6];
    engine [label="MotionEngine\n串行修改 JobState", fillcolor="#4b2f22", fontcolor="#fff8ed"];
    scheduler [label="OperationScheduler\n有界并发 + resource lease"];
    ikop [label="IK Operation"];
    planop [label="Planning Operation"];
    execop [label="Execution Operation"];
    join [label="Join / Barrier\n等待所需 Result"];
    finish [label="SUCCEEDED / FAILED / CANCELLED\n最终 Result + event chain", fillcolor="#687157", fontcolor="#fffaf0"];

    request -> admit;
    admit -> snapshot [label="acquire"];
    admit -> mailbox [label="create"];
    snapshot -> mailbox [label="snapshot_id"];
    mailbox -> engine [label="ordered Result"];
    engine -> mailbox [label="new state", color="#9b6548", fontcolor="#9b6548", constraint=false];
    engine -> scheduler [label="typed Command", penwidth=1.6];
    scheduler -> ikop;
    scheduler -> planop;
    scheduler -> execop;
    ikop -> join;
    planop -> join;
    execop -> join;
    join -> mailbox [label="typed Result", color="#9b6548", fontcolor="#9b6548", style=dashed, constraint=false];
    engine -> finish [label="terminal transition"];

    { rank=same; ikop; planop; execop; }
  }

  eventhub [label="EventHub + Telemetry\n旁路 Observer，不写 JobState", shape=note, fillcolor="#efe1cf", color="#9b6548"];

  ready -> request [label="open once", color="#687157", fontcolor="#687157", style=dashed, constraint=false];
  bind -> admit [label="frozen RuntimeGraph", constraint=false];
  engine -> eventhub [label="Event", color="#9b6548", fontcolor="#9b6548", style=dashed];
  execop -> eventhub [label="Telemetry", color="#687157", fontcolor="#687157", style=dashed];

  { rank=same; manifest; request; }
}
